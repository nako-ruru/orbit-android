# Normalize all text files to LF in the repo; platform checkout handles conversion.
* text=auto

# Shell scripts and gradle wrapper must stay LF (WSL / Linux compatibility)
*.sh text eol=lf
gradlew text eol=lf

# Batch scripts must stay CRLF (Windows cmd)
*.bat text eol=crlf

# Binary files — never touch line endings
*.so binary
*.a binary
*.jar binary
*.png binary
*.webp binary
*.jks binary
*.keystore binary
